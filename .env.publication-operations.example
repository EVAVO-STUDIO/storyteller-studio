# Copy to .env.publication-operations, restrict permissions and replace every placeholder.
# Use with: docker compose --env-file .env.publication-operations -f compose.publication-operations.yml ...

STORYTELLER_PUBLICATION_EVIDENCE_GATEWAY_PORT=8789

# Named local volumes. Override the data volume for isolated restore rehearsal.
STORYTELLER_PUBLICATION_DATA_VOLUME=storyteller-publication-data
STORYTELLER_PUBLICATION_BACKUP_VOLUME=storyteller-publication-backups

# Offline maintenance commands require a private operator ID and exact snapshot ID.
STORYTELLER_PUBLICATION_MAINTENANCE_ACTOR_ID=publication_maintenance_operator_001
STORYTELLER_PUBLICATION_BACKUP_SNAPSHOT_ID=publication_backup_replace_with_verified_snapshot_id

# Distinct process identities are required by publication-operations-preflight.
STORYTELLER_PUBLICATION_ALERT_WORKER_ID=publication_alert_worker_001
STORYTELLER_PUBLICATION_REFRESH_WORKER_ID=publication_refresh_worker_001
STORYTELLER_PUBLICATION_EVIDENCE_GATEWAY_ID=publication_evidence_gateway_001

# One route hash shared by refresh incident creation and alert recipient resolution.
# Replace this example value with the stable private route reference selected by operations.
STORYTELLER_PUBLICATION_REFRESH_RECIPIENT_REFERENCE_HASH=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
STORYTELLER_PUBLICATION_ALERT_RECIPIENT_BINDINGS={"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa":"PUBLICATION_ALERT_RECIPIENT_EMAIL"}
PUBLICATION_ALERT_RECIPIENT_EMAIL=operations@example.invalid

# Private evidence-gateway bearer token. Refresh and gateway configurations reference the same value.
STORYTELLER_PUBLICATION_REFRESH_PROVIDER_ID=publication_verification_gateway
STORYTELLER_PUBLICATION_REFRESH_ADAPTER_VERSION=1.0.0
STORYTELLER_PUBLICATION_REFRESH_VERIFICATION_TOKEN_ENV=PUBLICATION_EVIDENCE_GATEWAY_TOKEN
STORYTELLER_PUBLICATION_EVIDENCE_GATEWAY_TOKEN_ENV=PUBLICATION_EVIDENCE_GATEWAY_TOKEN
PUBLICATION_EVIDENCE_GATEWAY_TOKEN=replace-with-a-long-random-private-token

# Bounded refresh controls.
STORYTELLER_PUBLICATION_REFRESH_CONCURRENCY=2
STORYTELLER_PUBLICATION_REFRESH_BATCH_SIZE=100
STORYTELLER_PUBLICATION_REFRESH_POLL_INTERVAL_MS=60000
STORYTELLER_PUBLICATION_REFRESH_ACQUISITION_TIMEOUT_MS=60000
STORYTELLER_PUBLICATION_REFRESH_SHUTDOWN_GRACE_MS=30000

# Bounded evidence-gateway controls.
STORYTELLER_PUBLICATION_EVIDENCE_GATEWAY_MAX_BODY_BYTES=262144
STORYTELLER_PUBLICATION_EVIDENCE_GATEWAY_REQUEST_TIMEOUT_MS=15000
STORYTELLER_PUBLICATION_EVIDENCE_GATEWAY_SHUTDOWN_GRACE_MS=30000

# Private email delivery gateway configuration.
STORYTELLER_PUBLICATION_ALERT_CONCURRENCY=2
STORYTELLER_PUBLICATION_ALERT_BATCH_SIZE=100
STORYTELLER_PUBLICATION_ALERT_POLL_INTERVAL_MS=30000
STORYTELLER_PUBLICATION_ALERT_PROVIDER_TIMEOUT_MS=30000
STORYTELLER_PUBLICATION_ALERT_SHUTDOWN_GRACE_MS=30000
STORYTELLER_PUBLICATION_ALERT_EMAIL_PROVIDER_ID=publication_email_gateway
STORYTELLER_PUBLICATION_ALERT_EMAIL_ADAPTER_VERSION=1.0.0
STORYTELLER_PUBLICATION_ALERT_EMAIL_ENDPOINT=https://mail-gateway.example.invalid/v1/messages
STORYTELLER_PUBLICATION_ALERT_EMAIL_TOKEN_ENV=PUBLICATION_ALERT_EMAIL_TOKEN
PUBLICATION_ALERT_EMAIL_TOKEN=replace-with-private-email-gateway-token
STORYTELLER_PUBLICATION_ALERT_FROM_EMAIL_ENV=PUBLICATION_ALERT_FROM_EMAIL
PUBLICATION_ALERT_FROM_EMAIL=storyteller@example.invalid
STORYTELLER_PUBLICATION_ALERT_FROM_NAME=Storyteller Operations
