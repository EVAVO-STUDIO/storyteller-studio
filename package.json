{
  "name": "@evavo/storyteller-studio",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Provider-neutral audiobook narration and illustrated storytelling production studio.",
  "engines": {
    "node": ">=22.18.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run dev --workspace=@evavo/storyteller-web",
    "dev:api": "npm run dev --workspace=@evavo/storyteller-api",
    "storyteller": "tsx packages/cli/src/main.ts",
    "typecheck": "tsc --noEmit",
    "test:engine": "node scripts/run-tests.mjs engine",
    "test:api": "node scripts/run-tests.mjs api",
    "test:cli": "node scripts/run-tests.mjs cli",
    "test": "node scripts/run-tests.mjs all",
    "verify:foundation": "node scripts/check-foundation.mjs && node scripts/check-web-artifact-surface.mjs",
    "verify:private-boundary": "node scripts/check-private-boundary.mjs",
    "verify:storage": "node scripts/check-private-object-store.mjs",
    "verify:artifacts": "node scripts/check-artifact-registry.mjs && node scripts/check-artifact-api.mjs && npm run verify:storage",
    "verify": "npm run verify:foundation && npm run verify:private-boundary && npm run verify:artifacts && npm run typecheck && npm run test",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
