NODE_ENV=development
STORYTELLER_API_HOST=127.0.0.1
STORYTELLER_API_PORT=3100
STORYTELLER_API_TOKEN=
STORYTELLER_API_ACTOR_ID=local_operator
STORYTELLER_DATA_DIR=./storage
STORYTELLER_MAX_REQUEST_BYTES=2097152

# Generation admission is disabled until a queue driver is selected explicitly.
# The file queue is for local or one-host production only, never serverless or multi-instance use.
STORYTELLER_QUEUE_DRIVER=disabled
STORYTELLER_FILE_QUEUE_SINGLE_HOST=false

# Artifact reads are disabled until a registry driver is selected explicitly.
# The file registry is for local or one-host production only. Normal HTTP routes remain read-only.
STORYTELLER_ARTIFACT_DRIVER=disabled
STORYTELLER_FILE_ARTIFACT_STORE_SINGLE_HOST=false

# The dedicated worker is disabled by default and opens no HTTP listener.
# Enabled modes are once and continuous. File execution remains one-host only.
STORYTELLER_WORKER_MODE=disabled
STORYTELLER_WORKER_ID=storyteller_worker_001
STORYTELLER_WORKER_VERIFIER_ACTOR_ID=storyteller_verifier_001
STORYTELLER_WORKER_PROJECT_ID=
STORYTELLER_WORKER_CONCURRENCY=2
STORYTELLER_WORKER_POLL_INTERVAL_MS=1000
STORYTELLER_WORKER_LEASE_DURATION_MS=60000
STORYTELLER_WORKER_HEARTBEAT_INTERVAL_MS=20000
STORYTELLER_WORKER_PROVIDER_TIMEOUT_MS=120000
STORYTELLER_WORKER_OUTCOME_HISTORY_LIMIT=100
STORYTELLER_WORKER_SHUTDOWN_GRACE_MS=30000
STORYTELLER_FILE_WORKER_SINGLE_HOST=false
STORYTELLER_WORKER_OBJECT_PROVIDER=storyteller-local-private-store
STORYTELLER_WORKER_OBJECT_CONTAINER=storyteller-private-artifacts
STORYTELLER_WORKER_OBJECT_REGION=australia-southeast
# JSON map of provider IDs to server environment-variable names. Example only after an adapter is registered:
# {"provider_primary":"PROVIDER_PRIMARY_CREDENTIAL"}
STORYTELLER_WORKER_CREDENTIAL_BINDINGS={}

# Keep launch and session signing keys distinct and server-only.
STORYTELLER_HUB_LAUNCH_SECRET=
STORYTELLER_SESSION_SIGNING_SECRET=
STORYTELLER_EXPECTED_LAUNCH_AUDIENCE=

# Optional provider credentials. The core engine does not depend on any one provider.
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
GOOGLE_APPLICATION_CREDENTIALS=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Optional local and production media tools.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
PIPER_EXECUTABLE=
LOCAL_TTS_ENDPOINT=
