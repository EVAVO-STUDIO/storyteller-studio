NODE_ENV=development
STORYTELLER_API_HOST=127.0.0.1
STORYTELLER_API_PORT=3100
STORYTELLER_API_TOKEN=
STORYTELLER_API_ACTOR_ID=local_operator
STORYTELLER_DATA_DIR=./storage
STORYTELLER_MAX_REQUEST_BYTES=2097152

# Generation admission is disabled until a queue driver is selected explicitly.
# The file queue is for local or one-host production only, never serverless or multi-instance use.
STORYTELLER_QUEUE_DRIVER=disabled
STORYTELLER_FILE_QUEUE_SINGLE_HOST=false

# Artifact reads are disabled until a registry driver is selected explicitly.
# The file registry is for local or one-host production only. Normal HTTP routes remain read-only.
STORYTELLER_ARTIFACT_DRIVER=disabled
STORYTELLER_FILE_ARTIFACT_STORE_SINGLE_HOST=false

# Calibration reads are disabled until a store driver is selected explicitly.
# The file store is for local or one-host production only. Review and approval mutations remain internal.
STORYTELLER_CALIBRATION_DRIVER=disabled
STORYTELLER_FILE_CALIBRATION_STORE_SINGLE_HOST=false

# Select exactly one worker process role. Generation remains the default.
# Other private roles are publication-alerts, publication-refresh,
# publication-evidence-gateway and publication-operations-preflight.
STORYTELLER_WORKER_ROLE=generation

# The generation worker is disabled by default and opens no HTTP listener.
# Enabled modes are once and continuous. File execution remains one-host only.
STORYTELLER_WORKER_MODE=disabled
STORYTELLER_WORKER_ID=storyteller_worker_001
STORYTELLER_WORKER_VERIFIER_ACTOR_ID=storyteller_verifier_001
STORYTELLER_WORKER_PROJECT_ID=
STORYTELLER_WORKER_CONCURRENCY=2
STORYTELLER_WORKER_POLL_INTERVAL_MS=1000
STORYTELLER_WORKER_LEASE_DURATION_MS=60000
STORYTELLER_WORKER_HEARTBEAT_INTERVAL_MS=20000
STORYTELLER_WORKER_PROVIDER_TIMEOUT_MS=120000
STORYTELLER_WORKER_OUTCOME_HISTORY_LIMIT=100
STORYTELLER_WORKER_SHUTDOWN_GRACE_MS=30000
STORYTELLER_FILE_WORKER_SINGLE_HOST=false
STORYTELLER_WORKER_OBJECT_PROVIDER=storyteller-local-private-store
STORYTELLER_WORKER_OBJECT_CONTAINER=storyteller-private-artifacts
STORYTELLER_WORKER_OBJECT_REGION=australia-southeast
# JSON map of provider IDs to server environment-variable names.
# ElevenLabs example only after its full governed configuration is supplied:
# {"elevenlabs":"ELEVENLABS_API_KEY"}
STORYTELLER_WORKER_CREDENTIAL_BINDINGS={}

# Independent engineering is mandatory whenever the private generation worker is enabled.
# Leave reviewed profile evidence blank while disabled; enabled startup fails closed without it.
STORYTELLER_AUDIO_ENGINEERING_PROFILE=
STORYTELLER_AUDIO_ENGINEERING_PROFILE_VERSION=
STORYTELLER_AUDIO_ENGINEERING_PROFILE_REVIEWED_AT=
STORYTELLER_AUDIO_ENGINEERING_PROFILE_SOURCE_REFERENCE=
STORYTELLER_AUDIO_ENGINEERING_TIMEOUT_MS=120000
STORYTELLER_AUDIO_ENGINEERING_MAX_OUTPUT_BYTES=8388608

# ElevenLabs remains disabled unless every model, pricing, voice, privacy and credential record is valid.
# Pricing objects require immutable fingerprints produced by createElevenLabsPricingSnapshot.
# Voice bindings currently permit only remotely verified premade voices.
STORYTELLER_ELEVENLABS_ENABLED=false
STORYTELLER_ELEVENLABS_ADAPTER_VERSION=1.0.0
STORYTELLER_ELEVENLABS_MODEL_POLICIES=[]
STORYTELLER_ELEVENLABS_VOICE_BINDINGS=[]
STORYTELLER_ELEVENLABS_PRONUNCIATION_DICTIONARIES=[]
STORYTELLER_ELEVENLABS_DATA_POLICY={}
STORYTELLER_ELEVENLABS_TEXT_NORMALISATION=auto
STORYTELLER_ELEVENLABS_OUTPUT_BITRATE_KBPS=192
STORYTELLER_ELEVENLABS_MAX_RESPONSE_BYTES=134217728
STORYTELLER_ELEVENLABS_PREFLIGHT_TIMEOUT_MS=15000
STORYTELLER_ELEVENLABS_ALLOW_V3_PRODUCTION=false

# Publication alert delivery is independently disabled by default.
# Recipient bindings map one-way route hashes to environment-variable names containing addresses.
STORYTELLER_PUBLICATION_ALERT_MODE=disabled
STORYTELLER_PUBLICATION_ALERT_WORKER_ID=publication_alert_worker_001
STORYTELLER_PUBLICATION_ALERT_CONCURRENCY=2
STORYTELLER_PUBLICATION_ALERT_BATCH_SIZE=100
STORYTELLER_PUBLICATION_ALERT_POLL_INTERVAL_MS=30000
STORYTELLER_PUBLICATION_ALERT_PROVIDER_TIMEOUT_MS=30000
STORYTELLER_PUBLICATION_ALERT_SHUTDOWN_GRACE_MS=30000
STORYTELLER_FILE_PUBLICATION_ALERT_SINGLE_HOST=false
STORYTELLER_PUBLICATION_ALERT_RECIPIENT_BINDINGS={}
STORYTELLER_PUBLICATION_ALERT_EMAIL_PROVIDER_ID=publication_email_gateway
STORYTELLER_PUBLICATION_ALERT_EMAIL_ADAPTER_VERSION=1.0.0
STORYTELLER_PUBLICATION_ALERT_EMAIL_ENDPOINT=
STORYTELLER_PUBLICATION_ALERT_EMAIL_TOKEN_ENV=PUBLICATION_ALERT_EMAIL_TOKEN
PUBLICATION_ALERT_EMAIL_TOKEN=
STORYTELLER_PUBLICATION_ALERT_FROM_EMAIL_ENV=PUBLICATION_ALERT_FROM_EMAIL
PUBLICATION_ALERT_FROM_EMAIL=
STORYTELLER_PUBLICATION_ALERT_FROM_NAME=Storyteller Operations

# Publication refresh is independently disabled by default.
# The recipient hash must be present in publication-alert recipient bindings when enabled.
STORYTELLER_PUBLICATION_REFRESH_MODE=disabled
STORYTELLER_PUBLICATION_REFRESH_WORKER_ID=publication_refresh_worker_001
STORYTELLER_PUBLICATION_REFRESH_RECIPIENT_REFERENCE_HASH=
STORYTELLER_PUBLICATION_REFRESH_CONCURRENCY=2
STORYTELLER_PUBLICATION_REFRESH_BATCH_SIZE=100
STORYTELLER_PUBLICATION_REFRESH_POLL_INTERVAL_MS=60000
STORYTELLER_PUBLICATION_REFRESH_ACQUISITION_TIMEOUT_MS=60000
STORYTELLER_PUBLICATION_REFRESH_SHUTDOWN_GRACE_MS=30000
STORYTELLER_FILE_PUBLICATION_REFRESH_SINGLE_HOST=false
STORYTELLER_PUBLICATION_REFRESH_PROVIDER_ID=publication_verification_gateway
STORYTELLER_PUBLICATION_REFRESH_ADAPTER_VERSION=1.0.0
STORYTELLER_PUBLICATION_REFRESH_VERIFICATION_ENDPOINT=
STORYTELLER_PUBLICATION_REFRESH_VERIFICATION_TOKEN_ENV=PUBLICATION_EVIDENCE_GATEWAY_TOKEN

# The authenticated evidence gateway is independently disabled by default.
# It binds to loopback unless private-network exposure is explicitly acknowledged.
STORYTELLER_PUBLICATION_EVIDENCE_GATEWAY_MODE=disabled
STORYTELLER_PUBLICATION_EVIDENCE_GATEWAY_ID=publication_evidence_gateway_001
STORYTELLER_PUBLICATION_EVIDENCE_GATEWAY_BIND_HOST=127.0.0.1
STORYTELLER_PUBLICATION_EVIDENCE_GATEWAY_PORT=8789
STORYTELLER_PUBLICATION_EVIDENCE_GATEWAY_TOKEN_ENV=PUBLICATION_EVIDENCE_GATEWAY_TOKEN
PUBLICATION_EVIDENCE_GATEWAY_TOKEN=
STORYTELLER_PUBLICATION_EVIDENCE_GATEWAY_MAX_BODY_BYTES=262144
STORYTELLER_PUBLICATION_EVIDENCE_GATEWAY_REQUEST_TIMEOUT_MS=15000
STORYTELLER_PUBLICATION_EVIDENCE_GATEWAY_SHUTDOWN_GRACE_MS=30000
STORYTELLER_FILE_PUBLICATION_EVIDENCE_GATEWAY_SINGLE_HOST=false
STORYTELLER_PUBLICATION_EVIDENCE_GATEWAY_PRIVATE_NETWORK=false

# Set true only when an authenticated private HTTPS proxy terminates TLS before a loopback gateway.
STORYTELLER_PUBLICATION_OPERATIONS_GATEWAY_PROXY=false

# Keep launch and session signing keys distinct and server-only.
STORYTELLER_HUB_LAUNCH_SECRET=
STORYTELLER_SESSION_SIGNING_SECRET=
STORYTELLER_EXPECTED_LAUNCH_AUDIENCE=

# Provider credentials stay server-only and are referenced through worker credential bindings.
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
GOOGLE_APPLICATION_CREDENTIALS=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Optional local and production media tools.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
PIPER_EXECUTABLE=
LOCAL_TTS_ENDPOINT=
