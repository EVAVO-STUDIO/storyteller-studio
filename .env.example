NODE_ENV=development
STORYTELLER_API_HOST=127.0.0.1
STORYTELLER_API_PORT=3100
STORYTELLER_API_TOKEN=
STORYTELLER_API_ACTOR_ID=local_operator
STORYTELLER_DATA_DIR=./storage
STORYTELLER_MAX_REQUEST_BYTES=2097152

# Generation admission is disabled until a queue driver is selected explicitly.
# The file queue is for local or one-host production only, never serverless or multi-instance use.
STORYTELLER_QUEUE_DRIVER=disabled
STORYTELLER_FILE_QUEUE_SINGLE_HOST=false

# Artifact reads are disabled until a registry driver is selected explicitly.
# The file registry is for local or one-host production only. Normal HTTP routes remain read-only.
STORYTELLER_ARTIFACT_DRIVER=disabled
STORYTELLER_FILE_ARTIFACT_STORE_SINGLE_HOST=false

# Keep launch and session signing keys distinct and server-only.
STORYTELLER_HUB_LAUNCH_SECRET=
STORYTELLER_SESSION_SIGNING_SECRET=
STORYTELLER_EXPECTED_LAUNCH_AUDIENCE=

# Optional provider credentials. The core engine does not depend on any one provider.
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
GOOGLE_APPLICATION_CREDENTIALS=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Optional local and production media tools.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
PIPER_EXECUTABLE=
LOCAL_TTS_ENDPOINT=
